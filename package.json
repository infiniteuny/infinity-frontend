{
  "name": "@infiniteuny/infinity-frontend",
  "version": "1.4.4",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "nx run-many -t dev",
    "dev:dashboard": "nx dev dashboard",
    "dev:landing": "nx dev landing",
    "build": "nx run-many -t build",
    "build:dashboard": "nx build dashboard",
    "build:landing": "nx build landing",
    "start:dashboard": "nx start dashboard",
    "start:landing": "nx start landing",
    "lint": "nx run-many -t lint",
    "format": "nx run-many -t lint --args=--fix",
    "typecheck": "nx run-many -t typecheck"
  },
  "devDependencies": {
    "@nx/eslint": "24.0.4",
    "@nx/js": "24.0.4",
    "@nx/next": "24.0.4",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "nx": "24.0.4",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3"
  }
}
